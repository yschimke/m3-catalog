{
  "$comment": "Prototype manifest. Each document is a sticker body; each cell is a list of UI builder operations (the ui_builder_apply vocabulary) applied to it before export. The generated composable is named after the document title plus the cell name.",
  "stickers": [
    {
      "file": "stickers/card.uid",
      "variants": {
        "Slot": [{ "type": "deleteNode", "nodeId": "content" }],
        "Elevated": [
          { "type": "setProperty", "nodeId": "card", "property": "style", "value": { "type": "enum", "value": "elevated" } }
        ],
        "Elevated slot": [
          { "type": "setProperty", "nodeId": "card", "property": "style", "value": { "type": "enum", "value": "elevated" } },
          { "type": "deleteNode", "nodeId": "content" }
        ],
        "Outlined": [
          { "type": "setProperty", "nodeId": "card", "property": "style", "value": { "type": "enum", "value": "outlined" } }
        ],
        "Outlined slot": [
          { "type": "setProperty", "nodeId": "card", "property": "style", "value": { "type": "enum", "value": "outlined" } },
          { "type": "deleteNode", "nodeId": "content" }
        ]
      }
    }
  ]
}

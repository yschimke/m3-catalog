    "capabilityDigest": "candidate",
    "nativeRuntimeId": "candidate"
  },
  "environment": {
    "widthDp": 360,
    "heightDp": 640,
    "density": 2.625,
    "theme": "light",
    "locale": "en-US",
    "fontScale": 1,
    "layoutDirection": "ltr"

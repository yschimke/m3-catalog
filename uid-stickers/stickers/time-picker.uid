        "click": []
      }
    },
    "dialog": {
      "id": "dialog",
      "componentId": "m3/dialog",
      "properties": {},
      "slots": {
        "title": [
          "title"
        ],
        "text": [
          "body"
        ],
        "dismissButton": [
          "dismiss"
        ],
        "confirmButton": [
          "ok"
        ]
      },
      "modifiers": [

      "properties": {
        "input": {
          "type": "bool",
          "value": false
        }
      },
      "slots": {}
    },
    "picker": {
      "id": "picker",
      "componentId": "m3/time-picker",
      "properties": {
        "mode": {
          "type": "enum",
          "value": "dial"
        },
        "hour": {
          "type": "int",
          "value": 20
        },
        "minute": {
          "type": "int",
          "value": 0
        },
        "is24Hour": {
          "type": "bool",
          "value": true
        }
      },
      "slots": {}
    },
    "body": {
      "id": "body",
      "componentId": "layout/box",
      "properties": {
        "contentAlignment": {
          "type": "enum",
          "value": "center"
        }
      },
      "slots": {
        "children": [
          "picker"
        ]
      },
      "modifiers": [
        {
          "type": "fillMaxWidth"
        }
      ]
    },
    "toggle": {
      "id": "toggle",
      "componentId": "m3catalog/time-picker-mode-toggle",
      "properties": {
        "input": {
          "type": "bool",
          "value": false
        }
      },
      "slots": {},
      "eventBindings": {
        "click": []
      }
    },
    "cancel-label": {
      "id": "cancel-label",
      "componentId": "m3/text",
      "properties": {
        "text": {
          "type": "binding",
          "value": "dismissButton"
        }
      },
      "slots": {}
    },
    "cancel": {
      "id": "cancel",
      "componentId": "m3/text-button",
      "properties": {},
      "slots": {
        "content": [
          "cancel-label"
        ]
      },
      "eventBindings": {
        "click": []
      }
    },
    "dismiss": {
      "id": "dismiss",
      "componentId": "layout/row",
      "properties": {
        "verticalAlignment": {
          "type": "enum",
          "value": "center"
        }
      },
      "slots": {
        "children": [
          "toggle",
          "cancel"
        ]
      }
    },
    "ok-label": {
      "id": "ok-label",
      "componentId": "m3/text",
      "properties": {
        "text": {
          "type": "binding",
          "value": "confirmButton"
        }
      },
      "slots": {}
    },
    "ok": {
      "id": "ok",
      "componentId": "m3/text-button",
      "properties": {},

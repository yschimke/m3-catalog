        "weight"
      ],
      "wasm": {
        "platformSupported": true,
        "adapterStatus": "supported",
        "notes": "Draws the bytes the design's assets map pins under assetKey (content-addressed, hash-checked, stored by the host), the project-owned Jetcaster covers, or a visible placeholder carrying the key. External URLs are not accepted."
      },
      "code": {
        "symbol": "Image",
        "imports": [
          "androidx.compose.foundation.Image",
          "androidx.compose.ui.layout.ContentScale"
        ]
      },
      "svg": {
        "status": "raster-fallback-required",
        "fallback": "embedded-raster",
        "blocksExport": false,
        "notes": "The recorder embeds the pinned asset bytes, or the project-owned artwork, with source and payload provenance; a key with no bytes behind it is drawn as a vector placeholder rather than declared as a raster fallback."
      }

        "id": "compose-foundation",
        "title": "Compose Foundation",
        "platform": "foundation",
        "platformLabel": "Foundation",
        "module": "foundation-catalog",
        "variant": "debug"
    },
    "record": {
        "file": "components.json",
        "schemaVersion": 2,
        "components": 1
    },
    "statusSemantics": {
        "platform": "foundation",
        "platformLabel": "Foundation",
        "componentIdPrefix": "compose-foundation/",
        "previewSurfaces": {
            "wasm": {
                "fidelity": "approximate",
                "reason": "The builder's canvas is Compose Multiplatform for Wasm and links its own Compose, not this catalog's artifacts. The three layout primitives it draws through its own `foundation/*` adapters, which is as close as a box gets to being the same box; the scaffolds and the carousel it draws as placeholders, and says so."
            },
            "native": {
                "fidelity": "authoritative",
                "backend": "desktop",
                "reason": "The generated Kotlin compiled against this module's own classpath and rendered by Skiko — the same lane that produces this catalog's stickers."
            }
        },
        "componentMenu": {
            "groupOrder": [
                "Scaffolds",
                "Layout",
                "Containment",
                "Content",
                "Styles"
            ],
            "components": {}
        },
        "frame": {
            "$comment": "A rectangle, and no geometry block. This catalog frames nothing: a design is drawn in a BORROWING catalog's frame — a phone screen's device size, a watch's measured round-screen padding — and a frame declared here would be a claim about someone else's screen. `frame` is required by the schema, so it states the neutral answer and the seed device the mobile borrower already uses.",
            "adapter": "frame/rect",
            "seedDevice": "id:pixel_6"
        },
        "code": null,
        "templates": [],
        "colorTokens": null,
        "assetRegistry": null,
        "supersedes": null,

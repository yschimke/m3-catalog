                        "allowedValues": [
                            "top",
                            "center",
                            "bottom",
                            "spaceBetween",
                            "spaceAround",
                            "spaceEvenly"
                        ],
                        "notes": "Distribution down the axis. The three aligned values compose with verticalSpacingDp through Arrangement.spacedBy(space, alignment); the three space* values distribute the free space themselves, and Compose has no form that also inserts a fixed gap."
                    },
                    {
                        "name": "verticalSpacingDp",
                        "jsonType": "number",
                        "required": false
                    },
                    {
                        "name": "horizontalAlignment",

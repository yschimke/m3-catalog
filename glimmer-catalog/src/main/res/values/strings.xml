  <string name="card_content">This is a card</string>
  <string name="stack_card_body">Avocado, beet greens, mustard, kale and fava</string>

  <!-- Accessibility copy. Every icon slot in this module names the glyph's job, not its shape. -->
  <string name="cd_send">Send</string>
  <string name="cd_sender">Sender</string>
  <string name="cd_microphone">Microphone</string>
  <string name="cd_unmute_microphone">Unmute microphone</string>
  <string name="cd_header_artwork">Header artwork</string>


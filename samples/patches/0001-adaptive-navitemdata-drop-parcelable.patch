# 0001 — `NavItemData` implements `android.os.Parcelable`, which the desktop renderer has no
# `android.os` to implement against (2 unresolved imports, 9 unresolved references).
#
# It is the content-key type every ThreePaneScaffold sample here hands to its navigator, so it
# cannot be quarantined away: `ThreePaneScaffoldSample.kt` is a SINGLE file carrying all 13 adaptive
# samples, and quarantine is per file. Upstream makes it `Parcelable` so Android can save and
# restore the selected item across process death; a preview renders one frame and never saves, and
# `rememberSaveable` validates only when it does, so dropping the implementation changes nothing
# the sticker can show.
#
# Not a version skew and not expected to resolve itself: `android.os` will not appear on a Compose
# Multiplatform desktop classpath. Re-cut it if upstream restructures the class.
diff --git a/androidx/compose/material3/adaptive/samples/ThreePaneScaffoldSample.kt b/androidx/compose/material3/adaptive/samples/ThreePaneScaffoldSample.kt
